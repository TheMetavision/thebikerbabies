---
import { client as sanityClient } from '../lib/sanity'
const links = await sanityClient.fetch(`*[_type == "legalPage" && showInFooter == true] | order(order asc){ title, slug }`)
---
<ul class="legal-links">
  {links.map((l: any) => (
    <li>
      <a href={`/legal/${l.slug.current}`}>{l.title}</a>
    </li>
  ))}
</ul>

<style>
  .legal-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .legal-links li {
    list-style: none;
  }
  .legal-links a {
    color: #888;
    text-decoration: none;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }
  .legal-links a:hover {
    color: #ff6b00;
  }
</style>
