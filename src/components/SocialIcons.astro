---
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className = "" } = Astro.props;

const socials = [
  { label: "Follow us on YouTube",   href: "https://www.youtube.com/@TheBikerBabies",  icon: "/icons/social/youtube.svg" },
  { label: "Follow us on Instagram", href: "https://www.instagram.com/thebikerbabies", icon: "/icons/social/instagram.svg" },
  { label: "Follow us on Facebook",  href: "https://www.facebook.com/thebikerbabies",  icon: "/icons/social/facebook.svg" },
  { label: "Follow us on TikTok",    href: "https://www.tiktok.com/@thebikerbabies",   icon: "/icons/social/tiktok.svg" },
  { label: "Follow us on X",         href: "https://x.com/thebikerbabies",             icon: "/icons/social/x.svg" },
];
---

<div class:list={["social-icons", className]}>
  {
    socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={s.label}
        class="social-icon"
        style={`--icon-size: ${size}px`}
      >
        <img src={s.icon} alt="" width={size} height={size} loading="lazy" decoding="async" />
      </a>
    ))
  }
</div>

<style>
  .social-icons {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-size);
    height: var(--icon-size);
    transition: opacity 0.2s ease, filter 0.2s ease;
    text-decoration: none;
    opacity: 1;
  }

  .social-icon img {
    width: var(--icon-size);
    height: var(--icon-size);
    display: block;
    flex-shrink: 0;
    /* Subtle brightness tweak on hover - works across all browsers because
       it doesn't depend on SVG fill inheritance */
    transition: filter 0.2s ease;
  }

  .social-icon:hover img {
    /* Filter shifts grey towards the BB orange #ff6b00 */
    filter: brightness(0) saturate(100%) invert(48%) sepia(72%) saturate(2500%) hue-rotate(2deg) brightness(101%) contrast(101%);
  }
</style>
