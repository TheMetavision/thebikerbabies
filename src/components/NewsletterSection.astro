---
interface Props {
  quote?: string;
}

const { quote = "Where pint-sized power meets the open road!" } = Astro.props;
---

<section class="nl-section" id="newsletter">
  <div class="nl-inner">
    <div class="nl-content">
      <p class="nl-quote">"{quote}"</p>
      <h3 class="nl-heading">Subscribe to Our Newsletter</h3>
      <p class="nl-sub">No spam. Just adventures, merch drops, and Biker Babies updates.</p>
      <form class="nl-form" onsubmit="handleNlSubscribe(event)">
        <input
          type="email"
          placeholder="Enter your email address"
          class="nl-input"
          required
        />
        <button type="submit" class="nl-btn">
          <span class="nl-btn-text">Join the Crew</span>
          <span class="nl-arrow" aria-hidden="true">→</span>
        </button>
      </form>
      <p class="nl-message" id="nl-message" aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .nl-section {
    background: #ff6b00;
    padding: 5rem 2rem;
    overflow: hidden;
    border-top: 3px solid rgba(255, 255, 255, 0.15);
  }

  .nl-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .nl-content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .nl-quote {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin: 0;
    font-style: italic;
  }

  .nl-heading {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.05;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .nl-sub {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin: 0;
  }

  .nl-form {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .nl-input {
    flex: 1;
    min-width: 220px;
    padding: 0.9rem 1.2rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    color: #fff;
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .nl-input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .nl-input:focus {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.22);
  }

  .nl-btn {
    padding: 0.9rem 1.8rem;
    background: #1a0a00;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nl-btn:hover {
    background: #000;
    transform: translateY(-2px);
  }

  .nl-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
    font-size: 1.1rem;
  }

  .nl-btn:hover .nl-arrow {
    transform: translateX(5px);
  }

  .nl-message {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
    min-height: 1.2em;
    margin: 0;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .nl-form {
      flex-direction: column;
    }

    .nl-btn {
      justify-content: center;
    }
  }
</style>

<script>
  function handleNlSubscribe(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const input = form.querySelector("input") as HTMLInputElement;
    const btn = form.querySelector(".nl-btn") as HTMLButtonElement;
    const btnText = form.querySelector(".nl-btn-text") as HTMLSpanElement;
    const msg = document.getElementById("nl-message");
    if (!input?.value) return;

    const originalText = btnText.textContent;
    btnText.textContent = "Subscribing...";
    btn.disabled = true;

    fetch('https://connect.mailerlite.com/api/subscribers', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9.eyJhdWQiOiI0IiwianRpIjoiMTY2ZGZiYWEzYmFhMzQ2NGE2ZTY4YzgyZTYwNDFjNGZlMjM2MTZkN2YwMmVlNGVlNmQzYmJlY2YxNmMxOWE0N2ZlN2VjZTAwYTEwYzA0OTUiLCJpYXQiOjE3NzU4MjAyNzUuNzQxMTQ1LCJuYmYiOjE3NzU4MjAyNzUuNzQxMTQ3LCJleHAiOjQ5MzE0OTM4NzUuNzM0NDc1LCJzdWIiOiIyMjc4Mzk3Iiwic2NvcGVzIjpbXX0.D_zKiP5yLqx0XKrNeOt146s6arBj9oorzQFkOsmNHAjcpACKTlkEcckUDnaAlPbTZMJKJ2zJKacOmrjKUJURql5F6xako4CYgbLo5EqaMoDH5fznm_GtVDaWDcbm9QCBxgeeqYcamOfPnsvwPHUJThgKz2IZ4Y4Hc8H7IudylESYoktYoz91nBk4osPApnI5G0-PiTXaNvH0EdHdWl_0aNfnq7aLcg0bNjmL4a-xxxON6-t-ApS6EA6Wb87bVU568XlMk7AATxW800qHCEfU47YmoQ2jBLuLXWaFUYmzKgP4hhgzd8ku2GCERPUiJj90ZBevup-WSSgKCpIeRW0AZFmTW7bWRQlxuYzbw03Xw_l9MD__aK47JGLtSf7jZWTKBwrAv-gfe6brflahxjDmfNot0NfK8gYDnZkLOCHyDp8Ky7kNLZK8YCEl-jhQQOVBY_zVz3tu-omxMqHSE7PLX5_mDNt-Lslc6lkdk---Jg6hnLMTSfKnQRrC-awJ4ZYCgjtWUG2g1kQXpEQ8VXg6sdGwYKsf-64nMFQ05laakp-QOWr9vC52ZC1fr9Ctlykl2jUKJui2HY_akqSxjXgCY14apcGzmmMWEtNljC_A6qARuu6U5qcRDEmhCTew3yGrML8JMos4cbxbTTO5fndMbcYktjZ006PZasHlv4zyKX4'
      },
      body: JSON.stringify({
        email: input.value,
        groups: ['184360851525862497'],
        fields: { source: 'bikerbabies-newsletter' }
      })
    })
    .then(res => {
      if (res.ok || res.status === 200 || res.status === 201) {
        if (msg) msg.textContent = "You're in the crew! Expect adventures in your inbox.";
        input.value = "";
      } else if (res.status === 422) {
        if (msg) msg.textContent = "You're already part of the crew!";
        input.value = "";
      } else {
        throw new Error("Subscription failed");
      }
      btnText.textContent = originalText;
      btn.disabled = false;
    })
    .catch(() => {
      if (msg) msg.textContent = "Something went wrong — try again.";
      btnText.textContent = originalText;
      btn.disabled = false;
    });
  }

  (window as any).handleNlSubscribe = handleNlSubscribe;
</script>
