---
interface Props {
  quote?: string;
}

const { quote = "Where pint-sized power meets the open road!" } = Astro.props;
// Cloudflare Turnstile site key: public, baked in at build time, so a change
// in Netlify needs a rebuild. Without it the form renders no widget and
// /api/subscribe refuses its sign-ups.
const TURNSTILE_SITE_KEY =
  import.meta.env.TURNSTILE_SITE_KEY || process.env.TURNSTILE_SITE_KEY || '';
---

<section class="nl-section" id="newsletter">
  <div class="nl-inner">
    <div class="nl-content">
      <p class="nl-quote">"{quote}"</p>
      <h3 class="nl-heading">Subscribe to Our Newsletter</h3>
      <p class="nl-sub">No spam. Just adventures, merch drops, and Biker Babies updates.</p>
      <form class="nl-form" onsubmit="handleNlSubscribe(event)">
        <input
          type="email"
          placeholder="Enter your email address"
          class="nl-input"
          required
        />
        {/* Disabled until the script below has defined handleNlSubscribe: before
            that the inline onsubmit throws and the browser reloads the page,
            losing the typed email. */}
        <button type="submit" class="nl-btn" disabled>
          <span class="nl-btn-text">Join the Crew</span>
          <span class="nl-arrow" aria-hidden="true">→</span>
        </button>
        {/* Honeypot: off-screen, unreachable by pointer, keyboard or screen
            reader, with a name autofill does not recognise. Checked in
            netlify/functions/subscribe.mts. */}
        <div class="nl-extra" aria-hidden="true">
          <label for="bb-nl-extra">Extra</label>
          <input type="text" id="bb-nl-extra" name="bb_nl_extra" tabindex="-1" autocomplete="off" />
        </div>
      </form>
      {TURNSTILE_SITE_KEY && (
        <div
          class="cf-turnstile nl-turnstile"
          id="nl-turnstile"
          data-sitekey={TURNSTILE_SITE_KEY}
          data-theme="dark"
          data-action="newsletter"
          data-response-field-name="cf-turnstile-response"
        ></div>
      )}
      <p class="nl-message" id="nl-message" aria-live="polite" style="display:none;"></p>
      <div class="nl-confirm" id="nl-confirm" style="display:none;" role="status" aria-live="polite">
        <div class="nl-dispatch">
          <div class="nl-dispatch__badge" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ff6b00" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
          </div>
          <div>
            <div class="nl-dispatch__label">Almost in the crew</div>
            <div class="nl-dispatch__headline">Check your inbox, rider.</div>
            <div class="nl-dispatch__sub">If you're new, click the link we just sent to confirm. Didn't get one? Check your spam.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{TURNSTILE_SITE_KEY && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<style>
  .nl-extra {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .nl-turnstile {
    min-height: 65px;
  }

  .nl-section {
    background: #ff6b00;
    padding: 5rem 2rem;
    overflow: hidden;
    border-top: 3px solid rgba(255, 255, 255, 0.15);
  }

  .nl-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .nl-content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .nl-quote {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin: 0;
    font-style: italic;
  }

  .nl-heading {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.05;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .nl-sub {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin: 0;
  }

  .nl-form {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .nl-input {
    flex: 1;
    min-width: 220px;
    padding: 0.9rem 1.2rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    color: #fff;
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .nl-input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .nl-input:focus {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.22);
  }

  .nl-btn {
    padding: 0.9rem 1.8rem;
    background: #1a0a00;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nl-btn:hover {
    background: #000;
    transform: translateY(-2px);
  }

  .nl-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
    font-size: 1.1rem;
  }

  .nl-btn:hover .nl-arrow {
    transform: translateX(5px);
  }

  .nl-message {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
    min-height: 1.2em;
    margin: 0;
    font-weight: 600;
  }

  /* Newsletter dispatch confirmation (on orange bg) */
  .nl-dispatch {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #1a0a00;
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    border-left: 4px solid #fff;
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    text-align: left;
    animation: nlSlideIn 0.4s ease-out;
  }

  @keyframes nlSlideIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .nl-dispatch__badge {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nl-dispatch__label {
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.625rem;
    color: #ff6b00;
    letter-spacing: 2.5px;
    margin-bottom: 3px;
    text-transform: uppercase;
  }

  .nl-dispatch__headline {
    font-family: "Bebas Neue", sans-serif;
    color: #fff;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .nl-dispatch__sub {
    font-family: "Inter", sans-serif;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.8rem;
    margin-top: 3px;
  }

  @media (max-width: 480px) {
    .nl-form {
      flex-direction: column;
    }

    .nl-btn {
      justify-content: center;
    }
  }
</style>

<script>
  // Time on page: stamped now, compared with the submit time by the function.
  const nlLoadedAt = Date.now();
  // The Turnstile widget sits just outside the form, so its token is read from
  // the widget itself. A token is single use: reset after any failed attempt.
  const nlWidget = document.getElementById("nl-turnstile");
  const nlToken = () =>
    (nlWidget?.querySelector('input[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value?.trim() || "";
  const resetTurnstile = () => {
    const ts = (window as any).turnstile;
    if (nlWidget && ts && typeof ts.reset === "function") {
      try { ts.reset(nlWidget); } catch { /* not rendered yet */ }
    }
  };

  function handleNlSubscribe(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    const btn = form.querySelector(".nl-btn") as HTMLButtonElement;
    const btnText = form.querySelector(".nl-btn-text") as HTMLSpanElement;
    const nlConfirm = document.getElementById("nl-confirm");
    const nlMessage = document.getElementById("nl-message");
    if (!input?.value) return;

    const showError = (text: string) => {
      if (!nlMessage) return;
      nlMessage.textContent = text;
      nlMessage.style.display = "block";
    };
    if (nlMessage) nlMessage.style.display = "none";
    if (nlWidget && !nlToken()) {
      showError("Please complete the anti-spam check first.");
      return;
    }

    const originalText = btnText.textContent;
    btnText.textContent = "Subscribing...";
    btn.disabled = true;

    fetch('/api/subscribe', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: input.value,
        turnstileToken: nlToken(),
        bb_nl_extra: (form.querySelector('input[name="bb_nl_extra"]') as HTMLInputElement | null)?.value || "",
        bb_nl_ts_load: nlLoadedAt,
        bb_nl_ts_submit: Date.now(),
      })
    })
    .then(async (res) => {
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        // The same reply whoever the address belongs to (see subscribe.mts).
        form.style.display = "none";
        if (nlWidget) nlWidget.style.display = "none";
        if (nlConfirm) nlConfirm.style.display = "block";
      } else {
        // The function's own reason for a 4xx (a bad address, too many tries);
        // for a server-side failure the generic line.
        const reason = res.status < 500 && typeof data?.error === "string" ? data.error.replace(/\.?$/, ".") : "";
        throw Object.assign(new Error(reason || "Something went wrong. Please try again."), { fromServer: true });
      }
    })
    .catch((err) => {
      btnText.textContent = originalText;
      btn.disabled = false;
      resetTurnstile();
      // A network failure has the browser's own wording; show ours instead.
      showError(err && (err as any).fromServer ? (err as Error).message : "Couldn't reach us just now. Please try again.");
    });
  }

  (window as any).handleNlSubscribe = handleNlSubscribe;

  // The handler exists now; the buttons were rendered disabled until this point.
  document.querySelectorAll<HTMLButtonElement>('.nl-form .nl-btn').forEach((b) => { b.disabled = false; });
</script>
