---
interface Props {
  quote?: string;
}

const { quote = "Where pint-sized power meets the open road!" } = Astro.props;
---

<section class="nl-section" id="newsletter">
  <div class="nl-inner">
    <div class="nl-content">
      <p class="nl-quote">"{quote}"</p>
      <h3 class="nl-heading">Subscribe to Our Newsletter</h3>
      <p class="nl-sub">No spam. Just adventures, merch drops, and Biker Babies updates.</p>
      <form class="nl-form" onsubmit="handleNlSubscribe(event)">
        <input
          type="email"
          placeholder="Enter your email address"
          class="nl-input"
          required
        />
        <button type="submit" class="nl-btn">
          <span class="nl-btn-text">Join the Crew</span>
          <span class="nl-arrow" aria-hidden="true">→</span>
        </button>
      </form>
      <p class="nl-message" id="nl-message" aria-live="polite"></p>
    </div>
  </div>
</section>

<style>
  .nl-section {
    background: #ff6b00;
    padding: 5rem 2rem;
    overflow: hidden;
    border-top: 3px solid rgba(255, 255, 255, 0.15);
  }

  .nl-inner {
    max-width: 720px;
    margin: 0 auto;
  }

  .nl-content {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .nl-quote {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 1.7rem);
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
    line-height: 1.3;
    margin: 0;
    font-style: italic;
  }

  .nl-heading {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.05;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.25);
  }

  .nl-sub {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin: 0;
  }

  .nl-form {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .nl-input {
    flex: 1;
    min-width: 220px;
    padding: 0.9rem 1.2rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: 6px;
    color: #fff;
    font-family: "Inter", sans-serif;
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
    backdrop-filter: blur(4px);
  }

  .nl-input::placeholder {
    color: rgba(255, 255, 255, 0.55);
  }

  .nl-input:focus {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.22);
  }

  .nl-btn {
    padding: 0.9rem 1.8rem;
    background: #1a0a00;
    color: #fff;
    border: none;
    border-radius: 6px;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nl-btn:hover {
    background: #000;
    transform: translateY(-2px);
  }

  .nl-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
    font-size: 1.1rem;
  }

  .nl-btn:hover .nl-arrow {
    transform: translateX(5px);
  }

  .nl-message {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.9);
    min-height: 1.2em;
    margin: 0;
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .nl-form {
      flex-direction: column;
    }

    .nl-btn {
      justify-content: center;
    }
  }
</style>

<script>
  function handleNlSubscribe(e: Event) {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const input = form.querySelector("input") as HTMLInputElement;
    const msg = document.getElementById("nl-message");
    if (msg) {
      msg.textContent = "Thanks for subscribing! Stay tuned for adventures.";
    }
    input.value = "";
  }

  (window as any).handleNlSubscribe = handleNlSubscribe;
</script>
