---
import SocialIcons from "./SocialIcons.astro";
import LegalLinks from "./LegalLinks.astro";

const navLinks = [
  { label: "Home", href: "/" },
  { label: "Meet The Gang", href: "/meet-the-biker-babies" },
  { label: "Media", href: "/media" },
  { label: "Merch", href: "/merch" },
  { label: "Baby Babble", href: "/baby-babble" },
  { label: "Get In Touch", href: "/get-in-touch" },
];
---

<footer class="site-footer">
  <div class="footer-inner">

    <div class="footer-col footer-col--brand">
      <a href="/" class="footer-logo-link">
        <img
          src="https://assets.zyrosite.com/cdn-cgi/image/format=auto,w=375,h=375,fit=crop/m7V56PrMDJFy6Dyx/the-biker-babies-logo-AQEDOLz5DZf21RJ7.png"
          alt="The Biker Babies logo"
          class="footer-logo-img"
        />
      </a>
      <p class="footer-tagline">"Where pint-sized power meets the open road!"</p>
    </div>

    <nav class="footer-col footer-col--nav" aria-label="Footer navigation">
      <p class="footer-col-heading">Explore</p>
      <ul class="footer-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="footer-nav-link">{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col footer-col--legal" aria-label="Legal navigation">
      <p class="footer-col-heading">Legal</p>
      <LegalLinks />
    </nav>

    <div class="footer-col footer-col--social">
      <p class="footer-col-heading">Follow The Crew</p>
      <SocialIcons size={20} class="footer-social-row" />
      <p class="footer-social-blurb">Follow for episodes, merch drops, and adventures.</p>
    </div>

  </div>

  <div class="footer-bottom-wrap">
    <hr class="footer-rule" />
    <div class="footer-bottom">
      <p class="footer-copy">&copy; The Biker Babies 2026. Part of <a href="https://themetavision.co.uk" target="_blank" rel="noopener noreferrer" class="footer-bottom-link">The Metavision IP Universe</a>. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0b0b14;
    border-top: 1px solid rgba(255, 107, 0, 0.15);
    padding: 4rem 2rem 0;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.4fr;
    gap: 3rem;
    padding-bottom: 3rem;
    align-items: start;
  }

  /* -- Brand column ----------------------------------- */
  .footer-col--brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-logo-link {
    display: inline-block;
    width: fit-content;
    transition: transform 0.2s ease;
  }

  .footer-logo-link:hover {
    transform: scale(1.04);
  }

  .footer-logo-img {
    width: 96px;
    height: 96px;
    object-fit: contain;
    filter: drop-shadow(0 2px 14px rgba(255, 107, 0, 0.28));
    display: block;
  }

  .footer-tagline {
    font-style: italic;
    font-size: 0.9rem;
    color: #b0b0b0;
    line-height: 1.55;
    margin: 0;
  }

  /* -- Shared column heading -------------------------- */
  .footer-col-heading {
    font-family: "Bebas Neue", sans-serif;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #ff6b00;
    margin: 0 0 1.1rem;
  }

  /* -- Nav column ------------------------------------- */
  .footer-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-nav-link {
    color: #888;
    text-decoration: none;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .footer-nav-link:hover {
    color: #ff6b00;
  }

  /* -- Legal column (forces nav-list look on LegalLinks) */
  .footer-col--legal :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .footer-col--legal :global(li) {
    list-style: none;
  }

  .footer-col--legal :global(a) {
    color: #888;
    text-decoration: none;
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .footer-col--legal :global(a:hover) {
    color: #ff6b00;
  }

  /* -- Social column ---------------------------------- */
  .footer-col--social {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer-social-row {
    flex-wrap: wrap;
    gap: 12px !important;
  }

  .footer-social-blurb {
    font-size: 0.84rem;
    color: #666;
    line-height: 1.55;
    margin: 0;
  }

  /* -- Bottom bar ------------------------------------- */
  .footer-bottom-wrap {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-rule {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    margin: 0;
  }

  .footer-bottom {
    padding: 1.25rem 0;
    text-align: center;
  }

  .footer-copy {
    color: #888;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    margin: 0;
    opacity: 0.7;
  }

  .footer-bottom-link {
    color: #aaa;
    text-decoration: none;
    transition: color 0.2s ease;
    text-underline-offset: 3px;
  }

  .footer-bottom-link:hover {
    color: #ff6b00;
    text-decoration: underline;
    text-decoration-color: rgba(255, 107, 0, 0.5);
  }

  /* -- Responsive ------------------------------------- */
  @media (max-width: 1000px) {
    .footer-inner {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }

    .footer-col--brand {
      grid-column: 1 / -1;
      order: 0;
    }

    .footer-col--nav    { order: 1; }
    .footer-col--legal  { order: 2; }
    .footer-col--social { order: 3; grid-column: 1 / -1; }
  }

  @media (max-width: 500px) {
    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      width: 100%;
    }

    .footer-col--brand,
    .footer-col--nav,
    .footer-col--legal,
    .footer-col--social {
      grid-column: auto;
    }
  }
</style>
