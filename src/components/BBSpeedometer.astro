---
// src/components/BBSpeedometer.astro
//
// "Chrome Speedometer" — The Biker Babies theme-tune control.
// Canonically: the Clubhouse Ride-Out rig — chrome bike speedometer salvaged
// from a grown-up bike, wired by Santiago + Hiro + Zeya, mounted by the
// Clubhouse door, thumbed by Maddison when the crew rolls out.
//
// Per Arc spec arc-spec-bb-theme-tune-content-2026-04-30.md:
//   - All copy strings verbatim (Section D — PRESS TO IGNITE / KICK IT OVER /
//     WARMING UP... / RIDING / RIDE AGAIN? + optional "Roll out again?" sub-label)
//   - Position: bottom-right (FIRST of four to use bottom-right; FG + LR are top-right)
//   - Engine-start SFX prologue (~700ms, ~150ms overlap into theme) — BB-unique
//   - Reduced-motion variant (Section D.8)
//   - ARIA labels exact (Section D.7)
//   - Cart drawer collision handling (right-side 400px drawer; speedometer slides
//     left when drawer opens, restores on close)
//
// VERSION HISTORY:
//   v1.0 (2026-04-30) — initial build, shipped + live-verified
//   v1.1 (2026-04-30) — prominence floor retrofit (halo glow + attention pulse
//                       + mobile dial 56px + label restored on mobile + bigger label)
//   v1.2 (2026-04-30) — dismiss × button (session-scoped, reappears on next visit)
//   v1.3 (2026-04-30) — progress arc around bezel + rewind ↺ button (T1+T2)

export interface Props {
  audioUrl?: string | null;
  engineSfxUrl?: string | null;
  trackTitle?: string | null;
  trackArtist?: string | null;
  enabled?: boolean | null;
}

const {
  audioUrl = null,
  engineSfxUrl = null,
  trackTitle = 'The Biker Babies Main Theme',
  trackArtist = '',
  enabled = true,
} = Astro.props;

// Render nothing if disabled or no main audio uploaded yet.
// (Engine SFX is optional — its absence does NOT block render.)
const shouldRender = enabled !== false && !!audioUrl;
---

{shouldRender && (
  <div
    id="bb-speedometer"
    class="bb-speedometer bb-state-idle"
    data-state="idle"
    data-namespace="bb"
    data-audio-src={audioUrl}
    data-engine-sfx-src={engineSfxUrl ?? ''}
    data-track-title={trackTitle}
    data-track-artist={trackArtist}
  >
    <button
      type="button"
      class="bb-speedometer__button"
      aria-label="Play The Biker Babies theme music"
      data-aria-idle="Play The Biker Babies theme music"
      data-aria-loading="Loading The Biker Babies theme music"
      data-aria-playing="Pause The Biker Babies theme music"
      data-aria-ended="Replay The Biker Babies theme music"
      title={trackTitle}
    >
      <div class="bb-speedometer__dial" aria-hidden="true">
        <div class="bb-speedometer__bezel">
          <span class="bb-speedometer__bezel-shimmer" aria-hidden="true"></span>
        </div>

        <svg class="bb-speedometer__face" viewBox="0 0 64 64" preserveAspectRatio="xMidYMid meet" focusable="false">
          {/* Tick marks — 9 ticks (0, 5, 10, 15, 20, 25, 30, 35, 40 mph) */}
          <g transform="translate(32 32) rotate(-135)"><line class="bb-tick bb-tick--major" x1="0" y1="-26" x2="0" y2="-21" /></g>
          <g transform="translate(32 32) rotate(-101.25)"><line class="bb-tick bb-tick--minor" x1="0" y1="-26" x2="0" y2="-23" /></g>
          <g transform="translate(32 32) rotate(-67.5)"><line class="bb-tick bb-tick--major" x1="0" y1="-26" x2="0" y2="-21" /></g>
          <g transform="translate(32 32) rotate(-33.75)"><line class="bb-tick bb-tick--minor" x1="0" y1="-26" x2="0" y2="-23" /></g>
          <g transform="translate(32 32) rotate(0)"><line class="bb-tick bb-tick--major" x1="0" y1="-26" x2="0" y2="-21" /></g>
          <g transform="translate(32 32) rotate(33.75)"><line class="bb-tick bb-tick--minor" x1="0" y1="-26" x2="0" y2="-23" /></g>
          <g transform="translate(32 32) rotate(67.5)"><line class="bb-tick bb-tick--major" x1="0" y1="-26" x2="0" y2="-21" /></g>
          <g transform="translate(32 32) rotate(101.25)"><line class="bb-tick bb-tick--minor" x1="0" y1="-26" x2="0" y2="-23" /></g>
          <g transform="translate(32 32) rotate(135)"><line class="bb-tick bb-tick--major" x1="0" y1="-26" x2="0" y2="-21" /></g>

          {/* Numerals — counter-rotated so text reads upright */}
          <g transform="translate(32 32) rotate(-135)"><text class="bb-numeral" y="-15" text-anchor="middle" transform="rotate(135)">0</text></g>
          <g transform="translate(32 32) rotate(-67.5)"><text class="bb-numeral" y="-15" text-anchor="middle" transform="rotate(67.5)">10</text></g>
          <g transform="translate(32 32) rotate(0)"><text class="bb-numeral" y="-15" text-anchor="middle" transform="rotate(0)">20</text></g>
          <g transform="translate(32 32) rotate(67.5)"><text class="bb-numeral" y="-15" text-anchor="middle" transform="rotate(-67.5)">30</text></g>
          <g transform="translate(32 32) rotate(135)"><text class="bb-numeral" y="-15" text-anchor="middle" transform="rotate(-135)">40</text></g>

          {/* v1.3 — Progress arc. 270° span from -135° to +135°. JS sets stroke-dasharray="<pct> 100". */}
          <path
            class="bb-progress-arc"
            d="M 11.49,52.51 A 29,29 0 1,1 52.51,52.51"
            pathLength="100"
            fill="none"
            stroke="#ff6b00"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-dasharray="0 100"
          />

          <circle class="bb-rpm" cx="32" cy="6" r="1.5" />
        </svg>

        <div class="bb-speedometer__needle" aria-hidden="true"></div>
        <div class="bb-speedometer__pivot" aria-hidden="true"></div>

        <svg class="bb-speedometer__puff" viewBox="0 0 32 32" aria-hidden="true">
          <circle cx="16" cy="22" r="5" />
        </svg>
      </div>

      <span class="bb-speedometer__labels" aria-hidden="true">
        <span class="bb-label bb-label--idle">PRESS TO IGNITE</span>
        <span class="bb-label bb-label--hover">KICK IT OVER</span>
        <span class="bb-label bb-label--warming">WARMING UP...</span>
        <span class="bb-label bb-label--playing">RIDING</span>
        <span class="bb-label bb-label--ended">RIDE AGAIN?</span>
      </span>
    </button>

    <span class="bb-speedometer__subreplay" aria-hidden="true">Roll out again?</span>

    {/* v1.2 — dismiss × button (session-scoped, reappears next visit) */}
    <button
      type="button"
      class="bb-speedometer__dismiss"
      aria-label="Hide The Biker Babies theme music control until next visit"
      title="Hide for this session"
    >
      <span aria-hidden="true">&times;</span>
    </button>

    {/* v1.3 — rewind ↺ button (jumps audio to 0:00, keeps playing) */}
    <button
      type="button"
      class="bb-speedometer__rewind"
      aria-label="Restart The Biker Babies theme music from the beginning"
      title="Back to start"
    >
      <span aria-hidden="true">&#x21BA;</span>
    </button>
  </div>
)}

{/* Script UNWRAPPED from {shouldRender && ...} so Astro hoists + bundles it
    via Vite at build time (Labrats v1.1 hotfix lesson). Internal `if (root)`
    guard handles pages where the component DOM isn't rendered. */}
<script>
  import { Howl } from 'howler';
  import { createThemeAudio, prefersReducedMotion } from '../lib/themeAudio.js';

  const root = document.getElementById('bb-speedometer');
  if (root) {
    // v1.2 — session-scoped dismissal. If user clicked × in this tab's session,
    // hide entirely and skip all init. Re-checked on every script run.
    const DISMISS_KEY = 'bb_theme_dismissed';
    let isDismissed = false;
    try { isDismissed = sessionStorage.getItem(DISMISS_KEY) === '1'; } catch { /* private mode */ }
    if (isDismissed) {
      root.style.display = 'none';
    } else {
      const button = root.querySelector('.bb-speedometer__button');
      const dismissBtn = root.querySelector('.bb-speedometer__dismiss');
      const rewindBtn = root.querySelector('.bb-speedometer__rewind');     // v1.3
      const progressArc = root.querySelector('.bb-progress-arc');          // v1.3
      const audioSrc = root.dataset.audioSrc;
      const engineSfxSrc = (root.dataset.engineSfxSrc || '').trim();

      const SUPPRESSION = [
        /^\/cart(\/.*)?$/,
        /^\/checkout(\/.*)?$/,
        /^\/order(\/.*)?$/,
        /^\/media(\/.*)?$/,
      ];

      const PROLOGUE_DURATION = 700;
      const PROLOGUE_OVERLAP  = 150;
      const PROLOGUE_TO_THEME = PROLOGUE_DURATION - PROLOGUE_OVERLAP;

      let engineHowl = null;
      function ensureEngineHowl() {
        if (engineHowl || !engineSfxSrc) return engineHowl;
        try {
          engineHowl = new Howl({
            src: [engineSfxSrc],
            html5: true,
            preload: 'metadata',
            volume: 0.6,
          });
        } catch { engineHowl = null; }
        return engineHowl;
      }

      let prologueRunning = false;

      // v1.3 — progress arc polling. Updates SVG arc stroke-dasharray every
      // ~120ms while playing/replaying. Stops outside playback states.
      let progressInterval = null;
      function setProgressPct(pct) {
        if (!progressArc) return;
        const clamped = Math.max(0, Math.min(100, pct));
        progressArc.setAttribute('stroke-dasharray', clamped + ' 100');
      }
      function startProgressTracking() {
        stopProgressTracking();
        progressInterval = setInterval(() => {
          if (!controller) return;
          const pos = controller.getCurrentPosition();
          const dur = controller.getCurrentDuration();
          if (dur > 0) setProgressPct((pos / dur) * 100);
        }, 120);
      }
      function stopProgressTracking() {
        if (progressInterval) { clearInterval(progressInterval); progressInterval = null; }
      }

      const controller = createThemeAudio({
        namespace: 'bb',
        src: audioSrc,
        suppressionPaths: SUPPRESSION,
        onStateChange(state) {
          if (prologueRunning && state === 'idle') return;
          root.dataset.state = state;
          root.classList.remove(
            'bb-state-idle', 'bb-state-warming', 'bb-state-playing',
            'bb-state-replaying', 'bb-state-ended'
          );
          root.classList.add('bb-state-' + state);
          if (state === 'idle') {
            button.setAttribute('aria-label', button.dataset.ariaIdle);
          } else if (state === 'playing' || state === 'replaying') {
            button.setAttribute('aria-label', button.dataset.ariaPlaying);
          } else if (state === 'ended') {
            button.setAttribute('aria-label', button.dataset.ariaEnded);
          }
          // v1.3 — progress arc lifecycle.
          if (state === 'playing' || state === 'replaying') {
            startProgressTracking();
          } else {
            stopProgressTracking();
            if (state === 'idle') setProgressPct(0);
            else if (state === 'ended') setProgressPct(100);
          }
        },
      });

      button.addEventListener('click', (e) => {
        e.preventDefault();
        if (controller.isSuppressed) return;
        const currentState = controller.state;
        if (currentState === 'idle' && !prologueRunning) {
          runIgnitionPrologue();
        } else {
          controller.handleClick();
        }
      });

      function runIgnitionPrologue() {
        prologueRunning = true;
        root.dataset.state = 'warming';
        root.classList.remove(
          'bb-state-idle', 'bb-state-playing', 'bb-state-replaying', 'bb-state-ended'
        );
        root.classList.add('bb-state-warming');
        button.setAttribute('aria-label', button.dataset.ariaLoading);

        const sfx = ensureEngineHowl();
        if (sfx) {
          try { sfx.play(); } catch { /* silent fallback */ }
        }

        window.setTimeout(() => {
          controller.play();
          prologueRunning = false;
        }, PROLOGUE_TO_THEME);
      }

      if (prefersReducedMotion()) {
        root.classList.add('bb-reduced-motion');
      }

      // Cart-drawer collision detector — observes inline style.transform
      function bindCartDrawerObserver(retries = 10) {
        const drawer = document.querySelector(
          'astro-island[component-url*="CartDrawer"] > div, ' +
          'div[style*="right:0"][style*="translateX(100%)"], ' +
          'div[style*="right: 0"][style*="translateX(100%)"]'
        );
        if (!drawer) {
          if (retries > 0) {
            window.setTimeout(() => bindCartDrawerObserver(retries - 1), 200);
          }
          return;
        }
        const checkOpen = () => {
          const t = (drawer.style.transform || '').replace(/\s+/g, '');
          const closed = t.includes('translateX(100%)') || t.includes('translateX(100vw)') || t === '';
          document.body.classList.toggle('bb-cart-open', !closed);
        };
        checkOpen();
        const obs = new MutationObserver(checkOpen);
        obs.observe(drawer, { attributes: true, attributeFilter: ['style'] });
      }
      bindCartDrawerObserver();

      // v1.2 — dismiss button click
      if (dismissBtn) {
        dismissBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          const s = controller.state;
          if (s === 'playing' || s === 'replaying') {
            try { controller.pause(); } catch { /* no-op */ }
          }
          try { sessionStorage.setItem(DISMISS_KEY, '1'); } catch { /* no-op */ }
          root.style.display = 'none';
        });
      }

      // v1.3 — rewind button click → controller.replay() (stop + seek 0 + play)
      if (rewindBtn) {
        rewindBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          try { controller.replay(); } catch { /* no-op */ }
        });
      }

      window.addEventListener('astro:page-load', () => {
        try {
          if (sessionStorage.getItem(DISMISS_KEY) === '1') {
            root.style.display = 'none';
            return;
          }
        } catch { /* no-op */ }
        controller.applySuppression(window.location.pathname);
        bindCartDrawerObserver();
      });
      window.addEventListener('popstate', () => {
        controller.applySuppression(window.location.pathname);
      });
    }
  }
</script>

<style>
  /* ─── Container — bottom-right desktop, bottom-right mobile ──────────── */
  .bb-speedometer {
    position: fixed;
    bottom: max(24px, env(safe-area-inset-bottom, 24px));
    right: max(24px, env(safe-area-inset-right, 24px));
    z-index: 9000;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    pointer-events: auto;
    transition: transform 300ms ease, opacity 300ms ease;
  }
  body.bb-cart-open .bb-speedometer {
    transform: translateX(-400px);
  }

  /* ─── Button: clickable wrapper for dial + label ─────────────────────── */
  .bb-speedometer__button {
    appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: 'Bebas Neue', sans-serif;
    line-height: 1;
  }
  .bb-speedometer__button:focus-visible {
    outline: 2px solid #ff6b00;
    outline-offset: 4px;
    border-radius: 50%;
  }

  /* ─── Dial (PROMINENCE RETROFIT v1.1: halo glow + attention pulse) ──── */
  .bb-speedometer__dial {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #0f0a02;
    box-shadow:
      0 0 0 3px #1a0a00,
      0 0 0 4px rgba(255, 107, 0, 0.30),
      0 0 22px 2px rgba(255, 107, 0, 0.22),
      0 4px 18px rgba(0, 0, 0, 0.55);
  }

  /* PROMINENCE RETROFIT v1.1 — attention pulse, 2 cycles, NOT infinite */
  .bb-state-idle .bb-speedometer__dial::after {
    content: '';
    position: absolute;
    inset: -10px;
    border-radius: 50%;
    pointer-events: none;
    border: 2px solid #ff6b00;
    opacity: 0;
    animation: bb-attention-pulse 1.2s ease-out 2;
    animation-delay: 0.4s;
    animation-fill-mode: forwards;
  }
  @keyframes bb-attention-pulse {
    0%   { opacity: 0.75; transform: scale(0.92); }
    100% { opacity: 0;    transform: scale(1.55); }
  }
  .bb-speedometer:not(.bb-state-idle) .bb-speedometer__dial::after {
    animation: none;
    opacity: 0;
  }

  /* Chrome bezel — 3-tone via box-shadow */
  .bb-speedometer__bezel {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 3px #D9D9D9,
      inset 0 1px 0.5px 3px #FFFFFF,
      inset 0 -0.5px 1px 3px #5C5C5C;
  }
  .bb-speedometer__bezel-shimmer {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    overflow: hidden;
    pointer-events: none;
  }
  .bb-speedometer__bezel-shimmer::before {
    content: '';
    position: absolute;
    top: 0;
    left: -50%;
    width: 50%;
    height: 18px;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.55) 50%, transparent 100%);
    transform: skewX(-20deg);
    animation: bb-shimmer 4s linear infinite;
    opacity: 0;
  }
  .bb-state-playing .bb-speedometer__bezel-shimmer::before,
  .bb-state-replaying .bb-speedometer__bezel-shimmer::before {
    opacity: 1;
  }
  .bb-state-idle .bb-speedometer__button:hover .bb-speedometer__bezel,
  .bb-state-idle .bb-speedometer__button:focus-visible .bb-speedometer__bezel {
    animation: bb-bezel-pulse 250ms ease-out 1;
  }
  @keyframes bb-shimmer {
    0%   { transform: skewX(-20deg) translateX(0); }
    100% { transform: skewX(-20deg) translateX(360px); }
  }
  @keyframes bb-bezel-pulse {
    0%   { filter: brightness(1); }
    50%  { filter: brightness(1.35); }
    100% { filter: brightness(1); }
  }

  /* ─── Dial face SVG ──────────────────────────────────────────────────── */
  .bb-speedometer__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .bb-tick { stroke: rgba(255,255,255,0.6); stroke-width: 1; stroke-linecap: round; }
  .bb-tick--major { stroke-width: 1.2; }
  .bb-numeral {
    fill: #FFFFFF;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 6px;
    letter-spacing: 0.04em;
  }
  .bb-rpm {
    fill: #ff6b00;
    opacity: 0.3;
    transition: opacity 250ms ease;
  }
  .bb-state-warming .bb-rpm {
    opacity: 0.7;
    animation: bb-rpm-warming 0.18s steps(2) infinite;
  }
  @keyframes bb-rpm-warming {
    0% { opacity: 0.55; }
    100% { opacity: 0.95; }
  }
  .bb-state-playing .bb-rpm,
  .bb-state-replaying .bb-rpm {
    animation: bb-rpm-flicker 0.8s ease-in-out infinite;
  }
  @keyframes bb-rpm-flicker {
    0%   { opacity: 0.6; }
    17%  { opacity: 1; }
    35%  { opacity: 0.7; }
    52%  { opacity: 0.95; }
    73%  { opacity: 0.65; }
    91%  { opacity: 1; }
    100% { opacity: 0.6; }
  }
  .bb-state-ended .bb-rpm { opacity: 0.3; }

  /* ─── Needle ─────────────────────────────────────────────────────────── */
  .bb-speedometer__needle {
    position: absolute;
    left: 50%;
    top: 6px;
    width: 2px;
    height: 26px;
    margin-left: -1px;
    background: linear-gradient(180deg, #ff6b00 0%, #ff6b00 70%, #ff8c33 100%);
    border-radius: 1px 1px 0 0;
    box-shadow: 0 0 4px rgba(255, 107, 0, 0.5);
    transform-origin: 50% 100%;
    transform: rotate(-135deg);
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .bb-state-warming .bb-speedometer__needle {
    animation: bb-needle-twitch 0.18s ease-in-out infinite;
  }
  @keyframes bb-needle-twitch {
    0%, 100% { transform: rotate(-135deg); }
    50% { transform: rotate(-128deg); }
  }
  .bb-state-playing .bb-speedometer__needle,
  .bb-state-replaying .bb-speedometer__needle {
    transform: rotate(101.25deg);
    animation: bb-needle-sway 1.667s ease-in-out infinite alternate;
    transition: transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes bb-needle-sway {
    0%   { transform: rotate(67.5deg); }
    100% { transform: rotate(135deg); }
  }
  .bb-state-ended .bb-speedometer__needle {
    transform: rotate(-135deg);
    transition: transform 400ms ease-in-out;
  }

  /* ─── Pivot dot (gold, H.2 default) ───────────────────────────────────── */
  .bb-speedometer__pivot {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    margin-top: -3px;
    border-radius: 50%;
    background: radial-gradient(circle, #ffd700 0%, #c79a00 100%);
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.6);
    pointer-events: none;
  }

  /* ─── Exhaust puff (ENDED transient) ─────────────────────────────────── */
  .bb-speedometer__puff {
    position: absolute;
    bottom: -10px;
    left: 50%;
    width: 32px;
    height: 32px;
    margin-left: -16px;
    pointer-events: none;
    opacity: 0;
  }
  .bb-speedometer__puff circle { fill: rgba(255,255,255,0.3); }
  .bb-state-ended .bb-speedometer__puff {
    animation: bb-puff 800ms ease-out 1;
  }
  @keyframes bb-puff {
    0%   { opacity: 0; transform: translateY(0) scale(0.6); }
    20%  { opacity: 0.9; }
    100% { opacity: 0; transform: translateY(-14px) scale(1.4); }
  }

  /* ─── Labels (PROMINENCE RETROFIT v1.1: 13px + glow) ─────────────────── */
  .bb-speedometer__labels {
    display: inline-block;
    color: #FFFFFF;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px;
    letter-spacing: 0.09em;
    line-height: 1;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.85), 0 0 8px rgba(255, 107, 0, 0.35);
    white-space: nowrap;
    min-height: 14px;
  }
  .bb-label { display: none; }
  .bb-state-idle      .bb-label--idle    { display: inline; }
  .bb-state-warming   .bb-label--warming { display: inline; }
  .bb-state-playing   .bb-label--playing,
  .bb-state-replaying .bb-label--playing { display: inline; }
  .bb-state-ended     .bb-label--ended   { display: inline; color: #ff6b00; }
  .bb-state-idle .bb-speedometer__button:hover .bb-label--idle,
  .bb-state-idle .bb-speedometer__button:focus-visible .bb-label--idle { display: none; }
  .bb-state-idle .bb-speedometer__button:hover .bb-label--hover,
  .bb-state-idle .bb-speedometer__button:focus-visible .bb-label--hover { display: inline; }

  /* ─── Progress arc (v1.3) ────────────────────────────────────────────── */
  .bb-progress-arc {
    opacity: 0;
    transition: stroke-dasharray 120ms linear, opacity 200ms ease;
    filter: drop-shadow(0 0 2px rgba(255, 107, 0, 0.55));
  }
  .bb-state-playing .bb-progress-arc,
