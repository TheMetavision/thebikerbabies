---
import Layout from "../layouts/Layout.astro";
import { getAllProducts } from "../lib/sanity";
import { getAllWallArt } from "../lib/wallart";
import { ARTWORK_FROM_PRICE, formatGBP } from "../lib/artwork-pricing.cjs";

const products = await getAllProducts();
const wallArt = await getAllWallArt();

/* Split wall art by orientation, read from the dimensions baked into each
   Sanity image URL (...-WIDTHxHEIGHT.ext), so landscape and portrait pieces
   sit in their own tidy grids instead of clashing at equal width. */
function wallArtIsLandscape(url) {
  const m = /-(\d+)x(\d+)\.\w+(?:[?#]|$)/.exec(url || '');
  return !!m && Number(m[1]) >= Number(m[2]);
}
const wallArtLandscape = wallArt.filter((p) => wallArtIsLandscape(p.imageUrl));
const wallArtPortrait  = wallArt.filter((p) => !wallArtIsLandscape(p.imageUrl));
function seededRandom(seed) { const x = Math.sin(seed) * 10000; return x - Math.floor(x); }

const categoryOrder = [
  { key: 'tshirt', label: 'T-Shirts', types: ['tshirt'] },
  { key: 'hoodie', label: 'Hoodies', types: ['hoodie'] },
  { key: 'tank', label: 'Tanks', types: ['tank'] },
  { key: 'longsleeve', label: 'Long Sleeves', types: ['longsleeve'] },
  { key: 'kids-tshirt', label: 'Kids Tees', types: ['kids-tshirt'] },
  { key: 'kids-hoodie', label: 'Kids Hoodies', types: ['kids-hoodie'] },
  { key: 'kids-longsleeve', label: 'Kids Long Sleeves', types: ['kids-longsleeve'] },
  { key: 'babygrow', label: 'Baby Grows', types: ['babygrow'] },
  { key: 'tumbler', label: 'Tumblers', types: ['tumbler'] },
  { key: 'glass', label: 'Can Glasses', types: ['glass'] },
  { key: 'socks', label: 'Socks', types: ['socks'] },
  { key: 'sticker', label: 'Stickers', types: ['sticker'] },
  { key: 'pin', label: 'Badges', types: ['pin'] },
];

let seedCounter = 1;
const categories = categoryOrder.map((cat, catIdx) => ({
  key: cat.key, label: cat.label,
  items: products.flatMap((p, pIdx) =>
    (p.variants || []).filter((v) => cat.types.includes(v.productType)).map((variant) => {
      const colourImages = variant.colourImages || [];
      let image = variant.printfulImageUrl || ''; let backImage = ''; let displayColour = '';
      if (colourImages.length > 0) {
        /* Spread cards across real colourways (apparel) for variety. Colourless
           products — glass, tumbler, socks, etc. (colour "") — can carry several
           presentation shots (e.g. glass no-lid vs lid & straw), so a random pick
           would split the cards. For those, always use the primary (index 0) image.
           The seededRandom call still runs so apparel seeding is unchanged. */
        const distinctColours = [...new Set(colourImages.map((c) => c.colour || ''))].filter(Boolean);
        const r = seededRandom(pIdx * 13 + catIdx * 7 + seedCounter++);
        const idx = distinctColours.length > 1 ? Math.floor(r * colourImages.length) : 0;
        image = colourImages[idx].imageUrl || image; backImage = colourImages[idx].backImageUrl || ''; displayColour = colourImages[idx].colour || '';
      }
      const prices = (variant.sizePrices || []).map((s) => s.price).filter((n) => typeof n === 'number');
      const price = prices.length ? Math.min(...prices) : variant.basePrice;
      return { slug: p.slug, name: p.name, price, image, backImage, type: variant.label, typeKey: variant.productType, colour: displayColour };
    })
  ),
})).filter((cat) => cat.items.length > 0);

/* Wall art is its own tab (links to /wall-art/[slug], not /products/). If there
   are no garments at all, it becomes the default tab. */
const defaultCat = categories[0]?.key || (wallArt.length ? 'wallart' : 'tshirt');
---

<Layout title="Merch – The Biker Babies" description="Official Biker Babies merch – tees, hoodies, kids sizes, baby grows, wall art and more. Gear up and ride!">
  <section class="merch-hero">
    <div class="merch-hero-content">
      <div class="hero-text">
        <h1 class="merch-hero-title">Official Merch</h1>
        <span class="h1-accent-bar" aria-hidden="true"></span>
        <p class="merch-hero-sub">Gear Up &amp; Ride in Style</p>
        <p class="merch-hero-body">Character tees, hoodies and bottles for every fan of the crew — plus sticker sets, pin badges, wall art, kids sizes and baby grows for the youngest riders in the clubhouse.</p>
      </div>
      <div class="hero-image-wrap">
        <img src="/images/merch-hero.webp" alt="The Biker Babies merch" class="hero-img" loading="eager" />
      </div>
    </div>
  </section>

  <section class="products-section">
    <div class="products-inner">
      <nav class="cat-tabs" aria-label="Product categories">
        {categories.map((cat) => (
          <button class={`cat-tab ${cat.key === defaultCat ? 'active' : ''}`} data-cat={cat.key} aria-pressed={cat.key === defaultCat ? 'true' : 'false'}>
            {cat.label}<span class="cat-count">{cat.items.length}</span>
          </button>
        ))}
        {wallArt.length > 0 && (
          <button class={`cat-tab cat-tab--art ${defaultCat === 'wallart' ? 'active' : ''}`} data-cat="wallart" aria-pressed={defaultCat === 'wallart' ? 'true' : 'false'}>
            Wall Art<span class="cat-count">{wallArt.length}</span>
          </button>
        )}
      </nav>

      {categories.map((cat) => (
        <div class={`products-grid ${cat.key === defaultCat ? 'active' : ''}`} data-grid={cat.key}>
          {cat.items.map((item: any) => (
            <a href={`/products/${item.slug}?type=${item.typeKey}`} class="product-card">
              <div class="product-thumb">
                <img class="card-img card-img--front active" src={item.image} alt={`${item.name} ${item.type}`} loading="lazy" />
                {item.backImage && <img class="card-img card-img--back" src={item.backImage} alt={`${item.name} back`} loading="lazy" />}
                {item.backImage && (
                  <div class="card-carousel-controls">
                    <button class="card-arrow" type="button" aria-label="Toggle view">⇄</button>
                    <div class="card-dots"><span class="card-dot active"></span><span class="card-dot"></span></div>
                  </div>
                )}
                <div class="thumb-overlay"><span>View Product</span></div>
              </div>
              <div class="product-info">
                <h3>{item.name}</h3>
                <span class="product-type-label">{item.type}{item.colour ? ` · ${item.colour}` : ''}</span>
                <span class="product-price">{item.price != null ? `from £${item.price.toFixed(2)}` : ''}</span>
              </div>
            </a>
          ))}
        </div>
      ))}

      {wallArt.length > 0 && (
        <div class={`products-grid wallart-wrap ${defaultCat === 'wallart' ? 'active' : ''}`} data-grid="wallart">
          {wallArtLandscape.length > 0 && (
            <Fragment>
              <h3 class="wa-section-title">Landscape</h3>
              <div class="wa-grid wa-grid--land">
                {wallArtLandscape.map((piece: any) => (
                  <a href={`/wall-art/${piece.slug}`} class="product-card">
                    <div class="product-thumb">
                      <img class="card-img card-img--front active" src={piece.imageUrl} alt={piece.title} loading="lazy" />
                      <div class="thumb-overlay"><span>View Product</span></div>
                    </div>
                    <div class="product-info">
                      <h3>{piece.title}</h3>
                      <span class="product-type-label">Poster &amp; Canvas</span>
                      <span class="product-price">from {formatGBP(ARTWORK_FROM_PRICE)}</span>
                    </div>
                  </a>
                ))}
              </div>
            </Fragment>
          )}
          {wallArtPortrait.length > 0 && (
            <Fragment>
              <h3 class="wa-section-title">Portrait</h3>
              <div class="wa-grid wa-grid--port">
                {wallArtPortrait.map((piece: any) => (
                  <a href={`/wall-art/${piece.slug}`} class="product-card">
                    <div class="product-thumb">
                      <img class="card-img card-img--front active" src={piece.imageUrl} alt={piece.title} loading="lazy" />
                      <div class="thumb-overlay"><span>View Product</span></div>
                    </div>
                    <div class="product-info">
                      <h3>{piece.title}</h3>
                      <span class="product-type-label">Poster &amp; Canvas</span>
                      <span class="product-price">from {formatGBP(ARTWORK_FROM_PRICE)}</span>
                    </div>
                  </a>
                ))}
              </div>
            </Fragment>
          )}
        </div>
      )}

      <p class="sizing-link-wrap"><a href="/size-guide" class="sizing-link">Not sure on sizing? Check the size guide →</a></p>
    </div>
  </section>

  <section class="waitlist-section">
    <div class="waitlist-inner">
      <div class="waitlist-content">
        <h2 class="waitlist-heading">Never Miss a Drop</h2>
        <p class="waitlist-sub">New designs and kids gear land regularly. Join the newsletter and we'll hit you up the moment fresh merch rolls out of the workshop.</p>
        <form class="waitlist-form" id="waitlist-form" novalidate>
          <div class="form-row">
            <input type="email" id="waitlist-email" name="email" placeholder="your@email.com" class="waitlist-input" required autocomplete="email" />
            <button type="submit" class="waitlist-btn">Keep Me Posted</button>
          </div>
          <p class="form-status" id="form-status" aria-live="polite"></p>
        </form>
      </div>
      <div class="waitlist-image-wrap">
        <img src="/images/merch-waitlist.webp" alt="The Biker Babies merchandise preview" class="waitlist-img" />
        <div class="waitlist-img-glow"></div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
  const grids = document.querySelectorAll<HTMLDivElement>('.products-grid[data-grid]');
  tabs.forEach((tab) => tab.addEventListener('click', () => {
    const cat = tab.dataset.cat; if (!cat) return;
    tabs.forEach((t) => { t.classList.remove('active'); t.setAttribute('aria-pressed', 'false'); });
    tab.classList.add('active'); tab.setAttribute('aria-pressed', 'true');
    grids.forEach((g) => g.classList.toggle('active', g.dataset.grid === cat));
  }));
  document.querySelectorAll('.card-arrow').forEach((btn) => btn.addEventListener('click', (e) => {
    e.preventDefault(); e.stopPropagation();
    const wrap = (btn as HTMLElement).closest('.product-thumb'); if (!wrap) return;
    const front = wrap.querySelector('.card-img--front') as HTMLElement;
    const back = wrap.querySelector('.card-img--back') as HTMLElement;
    const dots = wrap.querySelectorAll('.card-dot'); if (!front || !back) return;
    const sf = front.classList.contains('active');
    front.classList.toggle('active', !sf); back.classList.toggle('active', sf);
    dots[0]?.classList.toggle('active', !sf); dots[1]?.classList.toggle('active', sf);
  }));

  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status") as HTMLParagraphElement | null;
  const btn = form?.querySelector(".waitlist-btn") as HTMLButtonElement | null;
  form?.addEventListener("submit", async (e) => {
    e.preventDefault(); if (!form || !statusEl || !btn) return;
    const email = (form.querySelector<HTMLInputElement>("#waitlist-email")?.value || "").trim();
    if (!email) { statusEl.textContent = "Please enter your email address."; statusEl.className = "form-status form-status--error"; return; }
    btn.disabled = true; btn.textContent = "Signing you up…"; statusEl.textContent = ""; statusEl.className = "form-status";
    try {
      const res = await fetch("/api/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email, fields: { source: "bikerbabies-merch-newsletter" } }) });
      if (res.ok) { statusEl.textContent = "You're on the list! Fresh drops, straight to your inbox."; statusEl.className = "form-status form-status--success"; form.reset(); }
      else if (res.status === 422) { statusEl.textContent = "You're already on the list — we've got you!"; statusEl.className = "form-status form-status--info"; }
      else { throw new Error("unexpected"); }
    } catch { statusEl.textContent = "Something went wrong. Please try again."; statusEl.className = "form-status form-status--error"; }
    finally { btn.disabled = false; btn.textContent = "Keep Me Posted"; }
  });
</script>

<style>
  .merch-hero { background: var(--color-bg); padding: 5rem 2rem 3rem; }
  .merch-hero-content { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; }
  .merch-hero-title { font-size: clamp(2.5rem, 6.5vw, 5rem); color: #fff; margin-bottom: 0.2rem; }
  .h1-accent-bar { display: block; width: 60px; height: 4px; background: var(--color-orange); border-radius: 9999px; margin-bottom: 1rem; box-shadow: 0 0 12px rgba(255,107,0,0.55); }
  .merch-hero-sub { font-family: "Bebas Neue", sans-serif; font-size: clamp(1.1rem, 2.5vw, 1.6rem); color: var(--color-orange); letter-spacing: 0.1em; margin-bottom: 0.75rem; }
  .merch-hero-body { font-size: 0.95rem; color: #d0d0d0; line-height: 1.7; max-width: 460px; }
  .hero-img { width: 100%; border-radius: 16px; }

  .products-section { padding: 4rem 2rem 5rem; background: var(--color-bg-section); }
  .products-inner { max-width: 1200px; margin: 0 auto; }

  .cat-tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 2.5rem; justify-content: center; }
  .cat-tab { display: inline-flex; align-items: center; gap: 6px; padding: 0.55rem 1.15rem; background: transparent; border: 1px solid var(--color-border); border-radius: 100px; color: #aaa; font-family: "Bebas Neue", sans-serif; font-size: 0.95rem; letter-spacing: 0.08em; white-space: nowrap; cursor: pointer; transition: all 0.25s; }
  .cat-tab:hover { border-color: var(--color-orange); color: #fff; }
  .cat-tab.active { background: var(--color-orange); border-color: var(--color-orange); color: #fff; }
  .cat-count { display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 10px; font-size: 0.7rem; background: rgba(255,255,255,0.1); color: inherit; }
  .cat-tab.active .cat-count { background: rgba(0,0,0,0.2); }

  .products-grid { display: none; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem 1.5rem; animation: gridFade 0.35s ease; }
  .products-grid.active { display: grid; }
  @keyframes gridFade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  .product-card { display: block; text-decoration: none; }
  .product-thumb { position: relative; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: var(--color-bg-card); border: 1px solid var(--color-border); }
  .card-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.35s ease, transform 0.3s ease; }
  .card-img.active { opacity: 1; }
  .product-card:hover .card-img.active { transform: scale(1.04); }
  .thumb-overlay { position: absolute; inset: 0; background: rgba(10,10,20,0.55); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.25s; }
  .product-card:hover .thumb-overlay { opacity: 1; }
  .thumb-overlay span { font-family: "Bebas Neue", sans-serif; font-size: 1rem; letter-spacing: 0.14em; color: var(--color-gold); border: 2px solid var(--color-gold); padding: 0.6rem 1.2rem; border-radius: 8px; text-transform: uppercase; }
  .card-carousel-controls { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 8px; z-index: 3; }
  .card-arrow { width: 28px; height: 28px; border-radius: 50%; background: rgba(0,0,0,0.6); border: none; color: #fff; cursor: pointer; }
  .card-dots { display: flex; gap: 4px; }
  .card-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(255,255,255,0.4); }
  .card-dot.active { background: var(--color-orange); }

  /* Wall art split into orientation sections so landscape and portrait pieces
     each sit in a tidy uniform grid and never look mismatched side by side.
     Each card's dark .product-thumb backing pillarboxes any letterbox cleanly. */
  .products-grid[data-grid="wallart"].active { display: block; }
  .wa-section-title { font-family: "Bebas Neue", sans-serif; font-size: 1.5rem; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; margin: 0 0 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--color-orange); }
  .wa-grid + .wa-section-title { margin-top: 3rem; }
  .wa-grid { display: grid; gap: 2rem 1.5rem; }
  .wa-grid--land { grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); }
  .wa-grid--port { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .wa-grid--land .product-thumb { aspect-ratio: 16 / 9; }
  .wa-grid--port .product-thumb { aspect-ratio: 2 / 3; }
  .wa-grid .card-img { object-fit: contain; }
  @media (max-width: 768px) { .wa-grid--land, .wa-grid--port { grid-template-columns: 1fr; } }

  .product-info { padding: 0.9rem 0.25rem 0; }
  .product-info h3 { font-family: "Bebas Neue", sans-serif; font-size: 1.15rem; letter-spacing: 0.05em; color: #fff; }
  .product-type-label { display: block; font-size: 0.72rem; color: #999; text-transform: uppercase; letter-spacing: 1px; margin-top: 2px; }
  .product-price { font-family: "Bebas Neue", sans-serif; font-size: 1rem; letter-spacing: 0.08em; color: var(--color-orange); margin-top: 0.3rem; display: block; }

  .sizing-link-wrap { text-align: center; margin-top: 3rem; }
  .sizing-link { font-family: "Bebas Neue", sans-serif; letter-spacing: 0.1em; font-size: 1rem; color: #aaa; border-bottom: 2px solid var(--color-orange); padding-bottom: 2px; text-transform: uppercase; }
  .sizing-link:hover { color: #fff; }

  /* Newsletter (unchanged from current BB merch) */
  .waitlist-section { padding: 5rem 2rem 6rem; background: var(--color-bg); overflow: hidden; }
  .waitlist-inner { max-width: 1200px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  .waitlist-heading { font-size: clamp(2.8rem, 5.5vw, 4.5rem); color: #fff; line-height: 1.05; margin-bottom: 1.25rem; letter-spacing: 0.04em; }
  .waitlist-sub { font-size: 1.05rem; color: #aaa; line-height: 1.7; max-width: 480px; margin-bottom: 2.5rem; }
  .form-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .waitlist-input { flex: 1 1 220px; background: rgba(255,255,255,0.05); border: 1.5px solid rgba(255,255,255,0.14); border-radius: 8px; padding: 1rem 1.25rem; font-size: 0.95rem; color: #fff; font-family: "Inter", sans-serif; outline: none; max-height: 54px; }
  .waitlist-input::placeholder { color: #555; }
  .waitlist-input:focus { border-color: rgba(255,107,0,0.55); box-shadow: 0 0 0 3px rgba(255,107,0,0.14); }
  .waitlist-btn { flex-shrink: 0; background: var(--color-orange); color: #fff; border: none; border-radius: 8px; padding: 1rem 2rem; font-family: "Bebas Neue", sans-serif; font-size: 1.15rem; letter-spacing: 0.1em; cursor: pointer; transition: background 0.2s, transform 0.15s; white-space: nowrap; box-shadow: 0 4px 20px rgba(255,107,0,0.35); }
  .waitlist-btn:hover:not(:disabled) { background: var(--color-orange-dark); transform: translateY(-2px); }
  .waitlist-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .form-status { margin-top: 0.75rem; font-size: 0.88rem; min-height: 1.2em; }
  .form-status--success { color: #4caf50; } .form-status--error { color: #ef5350; } .form-status--info { color: #aaa; }
  .waitlist-image-wrap { position: relative; }
  .waitlist-img { width: 100%; height: auto; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.6); position: relative; z-index: 1; display: block; }
  .waitlist-img-glow { position: absolute; inset: 10%; background: radial-gradient(ellipse at center, rgba(255,107,0,0.22) 0%, transparent 70%); filter: blur(30px); z-index: 0; border-radius: 50%; }

  @media (max-width: 900px) { .merch-hero-content, .waitlist-inner { grid-template-columns: 1fr; gap: 3rem; } .waitlist-image-wrap { order: -1; } }
  @media (max-width: 768px) { .products-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
  @media (max-width: 520px) { .products-grid { grid-template-columns: 1fr; } .form-row { flex-direction: column; } .waitlist-btn { width: 100%; } }
</style>
