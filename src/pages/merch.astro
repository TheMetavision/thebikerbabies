---
import Layout from "../layouts/Layout.astro";
import { getAllProducts } from "../lib/sanity";

/* NESTED model: one product doc = one design holding variants[] per garment.
   Card image = first variant's first colour mockup; price = cheapest size
   across all variants ("From £X"). Only active products are returned. */
const sanityProducts = await getAllProducts();

const fromPrice = (p) => {
  const prices = (p.variants || []).flatMap((v) => {
    const sp = (v.sizePrices || []).map((s) => s.price).filter((n) => typeof n === "number");
    return sp.length ? sp : (typeof v.basePrice === "number" ? [v.basePrice] : []);
  });
  return prices.length ? Math.min(...prices) : null;
};
const cardImage = (p) => {
  const v = p.variants?.[0];
  return v?.colourImages?.[0]?.imageUrl || v?.printfulImageUrl || null;
};

const products = (sanityProducts || []).map((p) => ({
  name: p.name,
  slug: p.slug,
  price: fromPrice(p),
  image: cardImage(p),
  blurb: p.description || p.tagline || "",
}));
---

<Layout
  title="Merch – The Biker Babies"
  description="Bring the adventure home with official Biker Babies merchandise – tees, hoodies, kids sizes, baby grows and more!"
>
  <section class="merch-hero">
    <div class="merch-hero-content">
      <div class="hero-text">
        <h1 class="merch-hero-title">Official Merch</h1>
        <span class="h1-accent-bar" aria-hidden="true"></span>
        <p class="merch-hero-sub">Gear Up &amp; Ride in Style</p>
        <p class="merch-hero-body">
          Bring the adventure home with <em>The Biker Babies</em> official merchandise! Character
          tees, hoodies and bottles for every fan of the crew — with kids sizes and baby grows for
          the youngest riders in the clubhouse.
        </p>
      </div>
      <div class="hero-image-wrap">
        <img
          src="/images/merch-hero.webp"
          alt="The Biker Babies merch drop – characters showing off official merchandise including t-shirts, stickers, badges and accessories"
          class="hero-img"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="products-section">
    <div class="products-inner">
      <h2 class="section-heading">Shop the Collection</h2>
      <div class="products-grid">
        {products.map((product) => (
          <a class="product-card" href={`/product/${product.slug}`}>
            <div class="product-card-img-wrap">
              {product.image ? (
                <img src={product.image} alt={product.name} class="product-card-img" loading="lazy" />
              ) : (
                <div class="product-card-placeholder"><span>The Biker Babies</span></div>
              )}
              <div class="product-card-overlay"><span class="product-card-cta">View Product</span></div>
            </div>
            <div class="product-card-body">
              <p class="product-card-name">{product.name}</p>
              {product.blurb && <p class="product-card-blurb">{product.blurb}</p>}
              {product.price != null && <p class="product-card-price">From £{product.price.toFixed(2)}</p>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="waitlist-section">
    <div class="waitlist-inner">

      <div class="waitlist-content">
        <h2 class="waitlist-heading">Never Miss a Drop</h2>
        <p class="waitlist-sub">
          New designs and kids gear land regularly. Join the newsletter and we'll hit you up the
          moment fresh merch rolls out of the workshop.
        </p>

        <form class="waitlist-form" id="waitlist-form" novalidate>
          <div class="form-row">
            <input
              type="email"
              id="waitlist-email"
              name="email"
              placeholder="your@email.com"
              class="waitlist-input"
              required
              autocomplete="email"
            />
            <button type="submit" class="waitlist-btn">Keep Me Posted</button>
          </div>
          <p class="form-status" id="form-status" aria-live="polite"></p>
        </form>
      </div>

      <div class="waitlist-image-wrap">
        <img
          src="/images/merch-waitlist.webp"
          alt="The Biker Babies merchandise preview"
          class="waitlist-img"
        />
        <div class="waitlist-img-glow"></div>
      </div>

    </div>
  </section>
</Layout>

<script>
  // ── Newsletter form → /api/subscribe (server-side MailerLite proxy) ──────
  const form = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const statusEl = document.getElementById("form-status") as HTMLParagraphElement | null;
  const btn = form?.querySelector(".waitlist-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form || !statusEl || !btn) return;

    const emailInput = form.querySelector<HTMLInputElement>("#waitlist-email");
    const email = emailInput?.value.trim() ?? "";

    if (!email) {
      statusEl.textContent = "Please enter your email address.";
      statusEl.className = "form-status form-status--error";
      return;
    }

    btn.disabled = true;
    btn.textContent = "Signing you up…";
    statusEl.textContent = "";
    statusEl.className = "form-status";

    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, fields: { source: "bikerbabies-merch-newsletter" } }),
      });

      if (res.ok) {
        statusEl.textContent = "You're on the list! Fresh drops, straight to your inbox.";
        statusEl.className = "form-status form-status--success";
        form.reset();
      } else if (res.status === 422) {
        statusEl.textContent = "You're already on the list — we've got you!";
        statusEl.className = "form-status form-status--info";
      } else {
        throw new Error("unexpected");
      }
    } catch {
      statusEl.textContent = "Something went wrong. Please try again.";
      statusEl.className = "form-status form-status--error";
    } finally {
      btn.disabled = false;
      btn.textContent = "Keep Me Posted";
    }
  });
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .merch-hero {
    background: var(--color-bg);
    padding: 5rem 2rem 3rem;
  }

  .merch-hero-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .merch-hero-title {
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .h1-accent-bar {
    display: block;
    width: 60px;
    height: 4px;
    background: var(--color-orange);
    border-radius: 9999px;
    margin-bottom: 1rem;
    box-shadow: 0 0 12px rgba(255, 107, 0, 0.55);
  }

  .merch-hero-sub {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    color: var(--color-orange);
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .merch-hero-body {
    font-size: 0.95rem;
    color: #d0d0d0;
    line-height: 1.7;
    max-width: 460px;
  }

  .hero-img {
    width: 100%;
    border-radius: 16px;
  }

  /* ── Products grid ────────────────────────────────────── */
  .products-section {
    padding: 4rem 2rem 5rem;
    background: var(--color-bg-section);
  }

  .products-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-heading {
    font-size: clamp(2rem, 4.5vw, 3rem);
    color: #fff;
    margin-bottom: 2.25rem;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem 1.5rem;
  }

  .product-card {
    display: block;
    text-decoration: none;
  }

  .product-card-img-wrap {
    position: relative;
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
  }

  .product-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .product-card:hover .product-card-img {
    transform: scale(1.04);
  }

  .product-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-placeholder span {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1rem;
    letter-spacing: 0.18em;
    color: var(--color-orange);
    text-transform: uppercase;
  }

  .product-card-overlay {
    position: absolute;
    inset: 0;
    background: rgba(10, 10, 20, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .product-card:hover .product-card-overlay {
    opacity: 1;
  }

  .product-card-cta {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1rem;
    letter-spacing: 0.14em;
    color: var(--color-gold);
    border: 2px solid var(--color-gold);
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    text-transform: uppercase;
  }

  .product-card-body {
    padding: 0.9rem 0.25rem 0;
  }

  .product-card-name {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.15rem;
    letter-spacing: 0.05em;
    color: #fff;
  }

  .product-card-blurb {
    font-size: 0.82rem;
    color: #999;
    line-height: 1.55;
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card-price {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--color-orange);
    margin-top: 0.4rem;
  }

  /* ── Newsletter section ───────────────────────────────── */
  .waitlist-section {
    padding: 5rem 2rem 6rem;
    background: var(--color-bg);
    overflow: hidden;
  }

  .waitlist-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .waitlist-heading {
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    color: #fff;
    line-height: 1.05;
    margin-bottom: 1.25rem;
    letter-spacing: 0.04em;
  }

  .waitlist-sub {
    font-size: 1.05rem;
    color: #aaa;
    line-height: 1.7;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }

  .waitlist-form {
    width: 100%;
  }

  .form-row {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .waitlist-input {
    flex: 1 1 220px;
    background: rgba(255, 255, 255, 0.05);
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    font-size: 0.95rem;
    color: #fff;
    font-family: "Inter", sans-serif;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    height: auto;
    max-height: 54px;
  }

  .waitlist-input::placeholder {
    color: #555;
  }

  .waitlist-input:focus {
    border-color: rgba(255, 107, 0, 0.55);
    box-shadow: 0 0 0 3px rgba(255, 107, 0, 0.14);
  }

  .waitlist-btn {
    flex-shrink: 0;
    background: var(--color-orange);
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 1rem 2rem;
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(255, 107, 0, 0.35);
  }

  .waitlist-btn:hover:not(:disabled) {
    background: var(--color-orange-dark);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(255, 107, 0, 0.5);
  }

  .waitlist-btn:active:not(:disabled) {
    transform: translateY(0);
  }

  .waitlist-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    min-height: 1.2em;
    line-height: 1.5;
    color: transparent;
  }

  .form-status--success { color: #4caf50; }
  .form-status--error   { color: #ef5350; }
  .form-status--info    { color: #aaa; }

  .waitlist-image-wrap {
    position: relative;
  }

  .waitlist-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    position: relative;
    z-index: 1;
    object-fit: contain;
    object-position: center center;
    display: block;
    background: transparent;
  }

  .waitlist-img-glow {
    position: absolute;
    inset: 10%;
    background: radial-gradient(ellipse at center, rgba(255, 107, 0, 0.22) 0%, transparent 70%);
    filter: blur(30px);
    z-index: 0;
    border-radius: 50%;
  }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 1024px) {
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 900px) {
    .merch-hero-content,
    .waitlist-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .waitlist-image-wrap {
      order: -1;
    }
  }

  @media (max-width: 600px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .form-row {
      flex-direction: column;
    }

    .waitlist-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
