---
import Layout from "../layouts/Layout.astro";
import NewsletterSection from "../components/NewsletterSection.astro";
import { getAllBlogPosts, urlFor } from "../lib/sanity";

const categoryStyles: Record<string, { cardBg: string; cardAccent: string }> = {
  "Behind the Scenes": {
    cardBg: "linear-gradient(135deg, #1a1008 0%, #3d1f00 100%)",
    cardAccent: "#ff6b00",
  },
  "bts": {
    cardBg: "linear-gradient(135deg, #1a1008 0%, #3d1f00 100%)",
    cardAccent: "#ff6b00",
  },
  "Characters": {
    cardBg: "linear-gradient(135deg, #0a1520 0%, #0d2e40 100%)",
    cardAccent: "#00aaff",
  },
  "Tips & Tricks": {
    cardBg: "linear-gradient(135deg, #0d1a0d 0%, #1a3d1a 100%)",
    cardAccent: "#4caf50",
  },
  "dispatches": {
    cardBg: "linear-gradient(135deg, #0d1a0d 0%, #1a3d1a 100%)",
    cardAccent: "#4caf50",
  },
  "Books": {
    cardBg: "linear-gradient(135deg, #1a1208 0%, #3d2e00 100%)",
    cardAccent: "#ffd700",
  },
  "Adventure": {
    cardBg: "linear-gradient(135deg, #150a1a 0%, #2e0d3d 100%)",
    cardAccent: "#c06aff",
  },
  "Inspiration": {
    cardBg: "linear-gradient(135deg, #0a1518 0%, #0d3040 100%)",
    cardAccent: "#00d4c8",
  },
};

const defaultStyle = {
  cardBg: "linear-gradient(135deg, #1a1008 0%, #3d1f00 100%)",
  cardAccent: "#ff6b00",
};

const sanityPosts = await getAllBlogPosts();

function formatDate(dateStr: string) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

const posts = (sanityPosts || []).map((p: any) => {
  // Some posts use `tag`, some use `category` — prefer `tag`, fall back to `category`.
  const styleKey = p.tag || p.category;
  const style = categoryStyles[styleKey] || defaultStyle;

  // Build a Sanity CDN URL for the card thumbnail (640x360, format-optimised).
  const featuredImageUrl = p.featuredImage
    ? urlFor(p.featuredImage).width(640).height(360).fit("crop").auto("format").url()
    : null;

  return {
    slug: p.slug,
    date: formatDate(p.publishedAt),
    title: p.title,
    excerpt: p.excerpt || "",
    tag: p.tag || p.category || "Blog",
    cardBg: style.cardBg,
    cardAccent: style.cardAccent,
    featuredImageUrl,
  };
});
---

<Layout
  title="Baby Babble – The Biker Babies Blog"
  description="Stories, speed and squad goals – the official Biker Babies blog with behind-the-scenes stories, character spotlights, and tips for young riders."
>
  <section class="blog-hero">
    <div class="blog-hero-content">
      <div class="hero-text">
        <h1 class="blog-hero-title">Baby Babble</h1>
        <span class="h1-accent-bar" aria-hidden="true"></span>
        <p class="blog-hero-sub">Stories, Speed & Squad Goals</p>
        <p class="blog-hero-body">
          Your go-to source for <em>Biker Babies</em> news, character spotlights,
          behind-the-scenes stories, and tips for young riders everywhere.
        </p>
      </div>
      <div class="hero-image-wrap">
        <img
          src="/images/baby-babble.webp"
          alt="The Biker Babies story time – Mateo reads aloud to the crew in a sunny park clearing with motorbikes parked behind them"
          class="hero-img"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="blog-section">
    <div class="blog-inner">
      <div class="blog-grid">
        {
          posts.map((post) => (
            <a href={`/baby-babble/${post.slug}`} class="blog-card-link">
              <article class="blog-card">
                <div
                  class="blog-card-image"
                  style={post.featuredImageUrl ? "" : `background: ${post.cardBg};`}
                >
                  {post.featuredImageUrl && (
                    <img
                      src={post.featuredImageUrl}
                      alt={post.title}
                      class="blog-card-img"
                      loading="lazy"
                      width="640"
                      height="360"
                    />
                  )}
                  <div
                    class="blog-card-image-bar"
                    style={`background: ${post.cardAccent};`}
                  />
                </div>
                <div class="blog-card-body">
                  <div class="blog-card-top">
                    <span
                      class="blog-tag"
                      style={`color: ${post.cardAccent}; border-color: ${post.cardAccent}33; background: ${post.cardAccent}1a;`}
                    >{post.tag}</span>
                  </div>
                  <h2 class="blog-title">{post.title}</h2>
                  <p class="blog-excerpt">{post.excerpt}</p>
                  <div class="blog-meta">
                    <span class="blog-date">{post.date}</span>
                  </div>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <NewsletterSection
    quote="Never miss a story – subscribe for the latest Biker Babies updates!"
  />
</Layout>

<style>
  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .blog-hero {
    background: var(--color-bg);
    padding: 5rem 2rem 3rem;
  }

  .blog-hero-content {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .blog-hero-title {
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    color: #fff;
    margin-bottom: 0.2rem;
  }

  .h1-accent-bar {
    display: block;
    width: 60px;
    height: 4px;
    background: #ff6b00;
    border-radius: 9999px;
    margin-bottom: 1rem;
    box-shadow: 0 0 12px rgba(255, 107, 0, 0.55);
  }

  .blog-hero-sub {
    font-family: "Bebas Neue", sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    color: #ff6b00;
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
  }

  .blog-hero-body {
    font-size: 0.95rem;
    color: #d0d0d0;
    line-height: 1.65;
  }

  .hero-image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
  }

  .hero-img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow:
      0 8px 40px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(255, 107, 0, 0.15);
    object-fit: cover;
    max-height: 420px;
  }

  @media (max-width: 768px) {
    .blog-hero-content {
      grid-template-columns: 1fr;
    }
    .hero-image-wrap {
      min-height: auto;
    }
    .hero-img {
      max-height: 300px;
    }
  }

  .blog-section {
    padding: 5rem 2rem;
    background: var(--color-bg);
  }

  .blog-inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .blog-card {
    background: var(--color-bg-card);
    border: 1px solid rgba(255, 107, 0, 0.1);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
    height: 100%;
  }

  .blog-card-link:hover .blog-card {
    border-color: rgba(255, 107, 0, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .blog-card-image {
    position: relative;
    height: 180px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1008;
  }

  .blog-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .blog-card-link:hover .blog-card-img {
    transform: scale(1.04);
  }

  .blog-card-image-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    opacity: 0.7;
    z-index: 1;
  }

  .blog-card-body {
    padding: 1.5rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .blog-card-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .blog-tag {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border: 1px solid;
    font-size: 0.75rem;
    font-family: "Bebas Neue", sans-serif;
    letter-spacing: 0.08em;
    border-radius: 3px;
  }

  .blog-title {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.35rem;
    color: #fff;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }

  .blog-excerpt {
    font-size: 0.88rem;
    color: #aaa;
    line-height: 1.65;
    flex: 1;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .blog-date {
    font-size: 0.8rem;
    color: #666;
  }

  @media (max-width: 640px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
