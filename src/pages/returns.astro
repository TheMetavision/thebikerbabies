---
// /returns — online returns for in-house wall art (src/components/ReturnsForm.astro;
// the API is netlify/functions/returns.mts).
//
// Built as the real page only when SHIPPING_ENABLED is "true" at build time
// (so it must be set in the Builds scope too) AND TURNSTILE_SITE_KEY is set
// (the lookup is protected by Cloudflare Turnstile). Otherwise this URL
// redirects to the Returns & Refunds policy, exactly as before shipping.
import Layout from '../layouts/Layout.astro';
import ReturnsForm from '../components/ReturnsForm.astro';
import { setting } from '../../netlify/functions/_shared/site-config.mjs';
import { CONTACT } from '../../netlify/functions/_shared/returns-eligibility.mjs';

const truthy = (v: unknown) => ['true', '1', 'yes'].includes(String(v ?? '').trim().toLowerCase());
const TURNSTILE_SITE_KEY = import.meta.env.TURNSTILE_SITE_KEY || process.env.TURNSTILE_SITE_KEY || '';
const enabled = truthy(process.env.SHIPPING_ENABLED || import.meta.env.SHIPPING_ENABLED) && Boolean(TURNSTILE_SITE_KEY);
const policyPath = setting('RETURNS_POLICY_PATH');
if (!enabled) return Astro.redirect(policyPath);
---
<Layout title="Return wall art · The Biker Babies" description="Return The Biker Babies wall art within 14 days of delivery: look up your order, see the return postage, and request a prepaid return label." noIndex={true}>
  <main class="returns-page">
    <section class="returns">
      <p class="returns__eyebrow">Returns</p>
      <h1 class="returns__title">Return wall art</h1>
      <ReturnsForm accent="#ff6b00" accentText="#0a0a0a" policyPath={policyPath} contact={CONTACT} turnstileSiteKey={TURNSTILE_SITE_KEY} />
    </section>
  </main>
</Layout>

<style>
  .returns-page {  min-height: 60vh; }
  .returns { max-width: 760px; margin: 0 auto; padding: 4rem 1.25rem 6rem; color: #e5e5e5; }
  .returns__eyebrow { text-transform: uppercase; letter-spacing: 4px; font-size: 0.82rem; color: #ff6b00; margin: 0 0 0.75rem; }
  .returns__title { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 0 0 1.5rem; }
</style>
